+            nn.Linear(d4, d4), nn.GELU(),
+            nn.Linear(d4, dim), nn.GELU(),
+            nn.Linear(dim, 1),
+        )
+        nn.init.zeros_(self.mlp[-1].weight)
+        nn.init.zeros_(self.mlp[-1].bias)
+        self.chunk_size = int(chunk_size)
