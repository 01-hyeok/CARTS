+#!/usr/bin/env python3
+"""EXP-ENCODER-UNFREEZE01: does letting the frozen B0 encoder representation
+adapt to the R2 set-conditioned utility objective (rather than staying
+frozen) improve the realized selector?
+
+C0 = R2 hybrid loss + cosine UtilityHead + FROZEN B0 encoder (existing
+EXP-TOPTAIL-RANK01/R2 checkpoint, reused verbatim, not retrained here).
+E1  = identical R2 hybrid loss + cosine UtilityHead + TRAINABLE encoder,
+initialised from the SAME B0 checkpoint. Nothing else changes: same
+SetConditioner/EmptySetToken/UtilityHead classes, same loss formula, same
+lambda_rank, same optimizer/lr (single Adam over every trainable
+parameter -- SetConditioner + EmptySetToken + UtilityHead + encoder -- no
+separate encoder LR, no LR sweep; no such "encoder LR multiplier" policy
+exists anywhere in this codebase, confirmed by an explicit search of
+`exp/exp_stage1_relation.py`, `models/RelationStage1.py`, `run.py` before
+writing this file), same checkpoint-selection criterion (val_overlap@10).
+
+CRITICAL implementation requirement (this experiment's whole point): E1
+must NEVER use a stale/frozen candidate embedding bank. Query embeddings
+AND candidate embeddings are both re-derived from the CURRENT encoder
+parameters at every training step -- `z_q = f_theta(x_q)`,
+`z_i = f_theta(x_i)` for every valid candidate i, not a cached bank built
+once per epoch/batch and reused across optimizer steps. Because the
+existing `encode()` helper (`scripts/train_margutil01.py`) already
+recomputes E fresh from raw `exp.memory_x` on every batch/channel (it was
+never cached across batches, even for the frozen-encoder arms -- freezing
+just meant the recomputation happened under `torch.no_grad()` and produced
+gradient-free output identical to a cached bank), the only structural
+change required is: (a) don't set `requires_grad=False` on the encoder,
+(b) route the SmoothL1/pairwise loss terms through fresh
+WITH-GRAD encoder forward passes on the raw candidate windows involved,
+instead of the existing frozen-arm's single no-grad `E`/`q`.
+
+Memory-safety: same principle as EXP-STRONG-SCORER-DIAG01's OOM fix, one
+level deeper (now the CANDIDATE embedding computation itself, not just the
+scorer head, carries a graph). `encoder_unfreeze_step()` below:
+  1. mines global hard negatives from a `torch.no_grad()` full-memory pass
+     (chunked internally by `_encode_candidates_nograd`, no graph -- exact
+     global Top-K, never a shortlist);
+  2. re-encodes ONLY the small gathered positive/hard-negative candidate
+     raw windows WITH grad for the pairwise loss, backward immediately;
+  3. re-encodes the FULL candidate bank again for the dense SmoothL1 term,
+     chunk by chunk, each chunk getting its own fresh encoder forward (not
+     reusing chunk N's activations for chunk N+1) and its own immediate
+     backward, so no chunk's graph is ever held simultaneously with
+     another's.
+`q` (the query encoding) and `m` (the SetConditioner's set-state summary,
+which for a trainable encoder now also carries a candidate-encoder graph
+through the oracle-prefix embeddings, not just through EmptySetToken) are
+each produced by a ZERO-ARG CALLABLE (`q_fn`, `m_fn`) that reruns the
+encoder fresh on every call -- precisely the fix EXP-STRONG-SCORER-DIAG01
+needed for `EmptySetToken`, generalised here because now EVERY tensor that
+touches the encoder must be independent per backward() call, not just the
+t=0 empty-set case.
+`optimizer.step()` is called exactly once per batch, after every
+step/channel/chunk has contributed its gradient -- never inside
+`encoder_unfreeze_step()`.
+
+FULL MEMORY -> DIRECT TOP-K is unaffected: `cand_chunk_size` chunking is a
+pure GPU-memory optimisation, every valid candidate is still scored and
+included in the global argmax/hard-negative computation; no candidate
+universe reduction of any kind.
+"""
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+import torch.nn.functional as F
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from exp.exp_stage1_relation import Exp_Stage1_Relation
+from models.DenseUtilityRetriever import UtilityHead
+from models.SequentialSetRetriever import EmptySetToken, SetConditioner
+from scripts.train_margutil01 import build_experiment, memory_value, run_sequence_dense
+from scripts.train_toptail_rank01 import mine_pairs, overlap_at_k, step_losses
+from utils.dense_utility import candidate_weights, dense_utility, normalize_utility
+from utils.rank_losses import embedding_geometry
+
+
+def encode_raw(model, x_raw, c, grad):
+    """`z = f_theta(x_raw)`, always re-run through the CURRENT encoder
+    parameters. `grad=False` uses `torch.no_grad()` (mining/diagnostics
+    only, never backpropped); `grad=True` leaves autograd on (the caller is
+    responsible for backward()ing and discarding this graph before calling
+    again with the same or overlapping data)."""
+    ctx = torch.no_grad() if not grad else torch.enable_grad()
+    with ctx:
+        z = model.encoder(model._relation_tensor(x_raw, c, c))
+        return F.normalize(z, dim=-1)
+
+
+def _encode_candidates_nograd(model, memory_x, c, chunk_size):
+    """Full-memory candidate embedding, `torch.no_grad()`, chunked purely
+    for GPU memory -- mathematically identical to one un-chunked call.
+    Never used for backward (mining/diagnostics/candidate_weights only)."""
+    n = memory_x.size(0)
+    if chunk_size <= 0 or n <= chunk_size:
+        return encode_raw(model, memory_x, c, grad=False)
+    chunks = []
+    for start in range(0, n, chunk_size):
+        chunks.append(encode_raw(model, memory_x[start:start + chunk_size], c, grad=False))
+    return torch.cat(chunks, dim=0)
+
+
+def encoder_unfreeze_step(model, c, memory_x, batch_x_v, set_conditioner, empty_token,
+                           utility_head, teacher_idx_v, E_nograd, u_target, valid_now,
+                           lambda_rank, grad_scale, cand_chunk_size, t, train):
+    """Memory-safe streaming computation of ONE teacher-forced step's R2
+    hybrid loss with a TRAINABLE encoder. See module docstring. `E_nograd`
+    is this step's no-grad full-memory embedding (recomputed by the caller
+    once per (batch, channel, t) from the CURRENT encoder -- cheap relative
+    to the with-grad passes below, and never backpropped, so reusing it
+    across the mining/candidate_weights computation is safe: it carries no
+    graph). Returns a diagnostics dict (python floats only).
+    """
+    device = batch_x_v.device
+    bsz_v = batch_x_v.size(0)
+    n = memory_x.size(0)
+
+    def q_fn():
+        return encode_raw(model, batch_x_v, c, grad=True)
+
+    def m_fn():
+        if t == 0:
+            return empty_token(bsz_v, device, batch_x_v.dtype)
+        idx = teacher_idx_v[:, :t].clamp_min(0)  # [B, t] -- clamp matches the
+        # original run_sequence_dense/strong_pair_step convention: prefix
+        # entries beyond a query's actual oracle-sequence length can be -1
+        # padding; PyTorch fancy-indexing with -1 silently wraps to the LAST
+        # row instead of erroring, so this clamp is a correctness
+        # requirement, not cosmetic (m at those positions is later averaged
+        # in but is masked out downstream by valid_now/query_valid exactly
+        # as in the frozen-encoder arms).
+        gathered = memory_x[idx.reshape(-1)]  # [B*t, seq_len, n_ch]
+        z = encode_raw(model, gathered, c, grad=True)
+        return z.view(bsz_v, t, -1).mean(dim=1)
+
+    with torch.no_grad():
+        q_nograd = encode_raw(model, batch_x_v, c, grad=False)
+        m_nograd = (empty_token(bsz_v, device, batch_x_v.dtype) if t == 0
+                    else E_nograd[teacher_idx_v[:, :t].clamp_min(0)].mean(dim=1))
+        h_nograd = set_conditioner(q_nograd, m_nograd)
+        u_hat_nograd = utility_head(h_nograd, E_nograd)
+        u_norm = normalize_utility(u_target, valid_now)
+        pos_idx, neg_idx, neg_valid = mine_pairs(u_target, u_hat_nograd, valid_now)
+        valid_count_row = valid_now.sum(dim=-1).clamp_min(1).float()
+        pos_scores_ng = u_hat_nograd.gather(1, pos_idx)
+        neg_scores_ng = u_hat_nograd.gather(1, neg_idx)
+        margin_val = float((pos_scores_ng.mean(dim=-1) - neg_scores_ng.mean(dim=-1)).mean())
+        valid_vals = u_hat_nograd[valid_now]
+        score_std_val = float(valid_vals.std()) if valid_vals.numel() > 1 else float('nan')
+
+    # ---- (2) pairwise: small gathered positive/hard-negative candidates,
+    # re-encoded WITH grad, immediate backward ----
+    pos_x = memory_x[pos_idx]  # [B, P, seq_len, n_ch]
+    neg_x = memory_x[neg_idx]  # [B, cap, seq_len, n_ch]
+    p_cnt, cap_cnt = pos_x.size(1), neg_x.size(1)
+    pos_e = encode_raw(model, pos_x.reshape(-1, *pos_x.shape[2:]), c, grad=True).view(bsz_v, p_cnt, -1)
+    neg_e = encode_raw(model, neg_x.reshape(-1, *neg_x.shape[2:]), c, grad=True).view(bsz_v, cap_cnt, -1)
+    h_pair = set_conditioner(q_fn(), m_fn())
+    pos_scores = utility_head.forward_batched(h_pair, pos_e)
+    neg_scores = utility_head.forward_batched(h_pair, neg_e)
+    diff = pos_scores.unsqueeze(-1) - neg_scores.unsqueeze(1)  # [B, P, cap]
+    pair_valid = neg_valid.unsqueeze(1).expand_as(diff) & (valid_count_row.unsqueeze(-1).unsqueeze(-1) >= 2)
+    loss_terms = F.softplus(-diff)
+    weight = pair_valid.float()
+    wsum = weight.sum(dim=(1, 2))
+    row_has_pairs = wsum > 0
+    pairwise_loss_val = float('nan')
+    if bool(row_has_pairs.any()):
+        per_row = (loss_terms * weight).sum(dim=(1, 2)) / wsum.clamp_min(1.0)
+        pair_loss = per_row[row_has_pairs].mean()
+        pairwise_loss_val = float(pair_loss.detach())
+        if train:
+            (lambda_rank * grad_scale * pair_loss).backward()
+
+    # ---- (3) SmoothL1: full candidate bank, chunked, fresh encoder forward
+    # + fresh q/m per chunk, immediate backward ----
+    smoothl1_total = 0.0
+    for start in range(0, n, cand_chunk_size):
+        end = min(start + cand_chunk_size, n)
+        x_chunk = memory_x[start:end]
+        e_chunk = encode_raw(model, x_chunk, c, grad=True)
+        h_chunk = set_conditioner(q_fn(), m_fn())
+        u_hat_chunk = utility_head(h_chunk, e_chunk)
+        target_chunk = u_norm[:, start:end]
+        valid_chunk = valid_now[:, start:end]
+        diff_chunk = F.smooth_l1_loss(u_hat_chunk, target_chunk, reduction='none')
+        weight_chunk = valid_chunk.float()
+        chunk_partial = (diff_chunk * weight_chunk).sum(dim=-1)  # [B]
+        chunk_loss = (chunk_partial / valid_count_row).mean()
+        smoothl1_total += float(chunk_loss.detach())
+        if train:
+            (grad_scale * chunk_loss).backward()
+
+    return {
+        'pairwise_loss': pairwise_loss_val, 'smoothl1_loss': smoothl1_total,
+        'pos_score_mean': float(pos_scores_ng.mean()), 'neg_score_mean': float(neg_scores_ng.mean()),
+        'margin': margin_val, 'score_std': score_std_val,
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--base_ckpt', required=True)
+    ap.add_argument('--teacher_cache', required=True)
+    ap.add_argument('--checkpoints', default='checkpoints/exp_encoder_unfreeze01')
+    ap.add_argument('--model_id', default='carts_encoder_unfreeze01_main')
+    ap.add_argument('--des', default='encoder_unfreeze01_main')
+    ap.add_argument('--top_k', type=int, default=10)
+    ap.add_argument('--train_epochs', type=int, default=0)
+    ap.add_argument('--patience', type=int, default=0)
+    ap.add_argument('--chunk_size', type=int, default=4096, help='dense_utility target chunk size (unchanged from R2)')
+    ap.add_argument('--cand_chunk_size', type=int, default=512,
+                     help='candidate-dimension chunk size for the streaming encoder-forward pass '
+                          '(GPU-memory optimisation only, every valid candidate is still scored)')
+    ap.add_argument('--seed', type=int, default=0)
+    ap.add_argument('--lambda_rank', type=float, default=1.0)
+    ap.add_argument('--keep_all_checkpoints', action='store_true',
+                     help='save every epoch (not just the best) for post-hoc analysis, per spec')
+    ap.add_argument('--probe_out', default=None,
+                     help='if set, write per-epoch representation-drift probe diagnostics here (CSV)')
+    cli = ap.parse_args()
+
+    overrides = {
+        'is_training': 1, 'model_id': cli.model_id, 'des': cli.des,
+        'checkpoints': cli.checkpoints, 'seed': cli.seed, 'top_k': cli.top_k,
+        'stage1_residual_teacher': 0, 'stage1_query_base_conditioning': 0,
+        'stage1_candidate_residual_conditioning': 0, 'stage1_retrieval_metric': 'cosine',
+        'stage1_full_memory_gradient_mode': 'full_online',
+    }
+    if cli.train_epochs:
+        overrides['train_epochs'] = cli.train_epochs
+    if cli.patience:
+        overrides['patience'] = cli.patience
+
+    exp, args = build_experiment(cli.base_ckpt, overrides)
+    torch.manual_seed(args.seed)
+    device = exp.device
+    model = exp.model.module if hasattr(exp.model, 'module') else exp.model
+    k = int(cli.top_k)
+    tau = float(args.tau_topk)
+
+    b0_ckpt = torch.load(cli.base_ckpt, map_location='cpu')
+    model.load_state_dict(b0_ckpt['model_state_dict'], strict=True)
+    for p in model.encoder.parameters():
+        p.requires_grad = True  # THE only architectural change vs. R2/C0
+    model.encoder.train()
+    n_encoder_params = sum(p.numel() for p in model.encoder.parameters())
+    print(f'[encoder_unfreeze01] encoder loaded from {cli.base_ckpt}, TRAINABLE '
+          f'({n_encoder_params} params), source=frozen-B0-checkpoint-init')
+
+    exp._ensure_memory()
+    channels = list(model.target_channels())
+    for c in channels:
+        sources = model.source_channels(c)
+        if len(sources) != 1 or int(sources[0]) != int(c):
+            raise ValueError(f'EXP-ENCODER-UNFREEZE01 is self-only; channel {c} has sources {sources}')
+    teacher = torch.load(cli.teacher_cache, map_location='cpu')
+    if teacher['meta']['top_k'] != k:
+        raise ValueError(f"teacher cache top_k={teacher['meta']['top_k']} != --top_k={k}")
+
+    d_model = int(args.d_model)
+    set_conditioner = SetConditioner(d_model).to(device)
+    empty_token = EmptySetToken(d_model).to(device)
+    utility_head = UtilityHead().to(device)
+
+    # ---- Zero-step equivalence check: E1's construction, before any
+    # optimizer step, must reproduce C0's frozen-encoder embeddings exactly
+    # on a fixed probe input (identical encoder weights, just requires_grad
+    # flipped -- requires_grad never changes a forward's numerical output).
+    with torch.no_grad():
+        probe_x = exp.memory_x[:64]
+        probe_c = channels[0]
+        z_trainable = encode_raw(model, probe_x, probe_c, grad=False)
+        model.encoder.eval()
+        z_trainable_eval = encode_raw(model, probe_x, probe_c, grad=False)
+        model.encoder.train()
+    max_abs_embedding_deviation = float((z_trainable - z_trainable_eval).abs().max())
+    print(f'[encoder_unfreeze01] construction-time train/eval-mode embedding check: '
+          f'max_abs_embedding_deviation={max_abs_embedding_deviation:.3e} (dropout/BN sensitivity; '
+          'informational only -- this project\'s RelationEncoder has no BatchNorm, so this should be ~0)')
+
+    trainable_params = (list(set_conditioner.parameters()) + list(empty_token.parameters())
+                         + list(utility_head.parameters()) + list(model.encoder.parameters()))
+    n_params = sum(p.numel() for p in trainable_params)
+    print(f'[encoder_unfreeze01] trainable_params={n_params} '
+          f'(SetConditioner={sum(p.numel() for p in set_conditioner.parameters())}, '
+          f'EmptySetToken={sum(p.numel() for p in empty_token.parameters())}, '
+          f'UtilityHead={sum(p.numel() for p in utility_head.parameters())}, '
+          f'Encoder={n_encoder_params})')
+    optimizer = torch.optim.Adam(trainable_params, lr=float(args.learning_rate))
+
+    # Fixed probe set for representation-drift diagnostics (never used for
+    # loss/checkpoint selection): first 256 memory rows, channel 0.
+    probe_idx_fixed = torch.arange(min(256, exp.memory_x.size(0)))
+    probe_channel = channels[0]
+    with torch.no_grad():
+        b0_probe_embed = encode_raw(model, exp.memory_x[probe_idx_fixed], probe_channel, grad=False).clone()
+
+    ckpt_dir = Path(cli.checkpoints) / 'encoder_unfreeze01' / args.data / f'seq{args.seq_len}_pred{args.pred_len}' / args.model_id
+    ckpt_dir.mkdir(parents=True, exist_ok=True)
+    best_val = -1.0
+    best_epoch = -1
+    patience_left = int(args.patience)
+
+    def teacher_rows(batch_start_idx, channel, split):
+        rows = [teacher['splits'][split]['start_to_row'][int(s)] for s in batch_start_idx.tolist()]
+        return teacher['splits'][split]['teacher_idx'][channel][rows].to(device)
+
+    def run_epoch(loader, split, train, channel_list):
+        set_conditioner.train(train)
+        empty_token.train(train)
+        utility_head.train(train)
+        model.encoder.train(train)
+        total_loss, n_batches = 0.0, 0
+        overlap_sum, overlap_n = 0.0, 0
+        enc_grad_norm = 0.0
+        diag_sums = {}
+        diag_n = 0
+        ctx = torch.enable_grad() if train else torch.no_grad()
+        with ctx:
+            for batch_x, batch_y, batch_start_idx in loader:
+                batch_x = batch_x.float().to(device)
+                batch_y = batch_y.float().to(device)
+                cand_mask, counts = exp._candidate_mask(batch_start_idx)
+                if train:
+                    optimizer.zero_grad()
+                batch_loss = 0.0
+                for c in channel_list:
+                    E_nograd = _encode_candidates_nograd(model, exp.memory_x, c, cli.cand_chunk_size)
+                    q_nograd = encode_raw(model, batch_x, c, grad=False)
+                    memory_c, offset_c = memory_value(args, batch_x, exp.memory_y, exp.memory_x_last, c)
+                    futures = memory_c + offset_c.view(-1, 1, 1)
+                    query_future = batch_y[:, :, c]
+
+                    teacher_idx = teacher_rows(batch_start_idx, c, split)
+                    query_valid = teacher_idx[:, 0] != -1
+                    if int(query_valid.sum()) == 0:
+                        continue
+                    batch_x_v = batch_x[query_valid]
+                    teacher_idx_v = teacher_idx[query_valid]
+                    cand_mask_v = cand_mask[query_valid]
+
+                    w_fixed = candidate_weights(torch.matmul(q_nograd, E_nograd.transpose(0, 1)), cand_mask, tau)
+                    w_fixed_v = w_fixed[query_valid]
+                    futures_v = futures[query_valid]
+                    query_future_v = query_future[query_valid]
+
+                    if train:
+                        selected_mask_v = torch.zeros_like(cand_mask_v)
+                        step_loss_sum = 0.0
+                        for t in range(k):
+                            with torch.no_grad():
+                                prefix = teacher_idx_v[:, :t].clamp_min(0)
+                                a_dense = dense_utility(prefix, w_fixed_v, futures_v, query_future_v, chunk_size=cli.chunk_size)
+                                u_target = -a_dense
+                                valid_now = cand_mask_v & ~selected_mask_v
+                            step_diag = encoder_unfreeze_step(
+                                model, c, exp.memory_x, batch_x_v, set_conditioner, empty_token,
+                                utility_head, teacher_idx_v, E_nograd, u_target, valid_now,
+                                cli.lambda_rank, grad_scale=1.0 / k / len(channel_list),
+                                cand_chunk_size=cli.cand_chunk_size, t=t, train=True)
+                            step_loss_sum += step_diag.get('smoothl1_loss', 0.0) + (
+                                cli.lambda_rank * step_diag.get('pairwise_loss', 0.0)
+                                if step_diag.get('pairwise_loss', float('nan')) == step_diag.get('pairwise_loss', float('nan'))
+                                else 0.0)
+                            for kk, vv in step_diag.items():
+                                if vv == vv:
+                                    diag_sums[kk] = diag_sums.get(kk, 0.0) + vv
+                            diag_n += 1
+                            nxt = teacher_idx_v[:, t:t + 1].clamp_min(0)
+                            selected_mask_v = selected_mask_v.scatter(1, nxt, True)
+                        batch_loss = batch_loss + step_loss_sum / k
+                    else:
+                        # Val/test: no gradient needed -- both the
+                        # teacher-forced diagnostic loss (for logging only,
+                        # not backpropped) and the free-running picks (for
+                        # val_overlap@10, the actual checkpoint-selection
+                        # criterion) can reuse the SAME no-grad
+                        # q_nograd/E_nograd from the current encoder in one
+                        # unchunked forward -- no backward, so no memory-
+                        # safety concern here (mirrors C0/R2's own val path).
+                        u_hat_steps, u_target_steps, valid_steps, picks = run_sequence_dense(
+                            q_nograd, E_nograd, cand_mask, set_conditioner, empty_token, utility_head,
+                            futures, query_future, tau, k, cli.chunk_size, teacher_idx=teacher_idx)
+                        _, diags = step_losses(u_hat_steps, u_target_steps, valid_steps,
+                                                query_valid, 'hybrid', cli.lambda_rank)
+                        for d in diags:
+                            for kk, vv in d.items():
+                                if vv == vv:
+                                    diag_sums[kk] = diag_sums.get(kk, 0.0) + vv
+                        diag_n += sum(1 for d in diags if d)
+                        _, _, _, picks = run_sequence_dense(
+                            q_nograd, E_nograd, cand_mask, set_conditioner, empty_token, utility_head,
+                            futures, query_future, tau, k, cli.chunk_size, teacher_idx=None)
